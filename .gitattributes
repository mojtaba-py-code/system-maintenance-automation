# Normalise line endings in the repository to LF. CI runs on Linux, Windows and
# macOS, so a checkout that differs by platform would produce spurious diffs.
* text=auto eol=lf

# Windows-only scripts must keep CRLF to run correctly.
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Binary formats git must not touch.
*.png  binary
*.jpg  binary
*.ico  binary
*.zip  binary
*.gz   binary
*.bz2  binary
*.db   binary

# Keep generated example OUTPUT out of language statistics and diffs. The
# generator itself is ordinary source and must stay reviewable.
examples/**                   linguist-generated=true
examples/generate_examples.py linguist-generated=false
